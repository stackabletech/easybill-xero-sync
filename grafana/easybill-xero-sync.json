{
  "title": "easybill → Xero sync status",
  "uid": "easybill-xero-sync",
  "description": "Current sync status of easybill invoices and customers in Xero. Fed by the OTLP metrics of easybill-xero.",
  "tags": [
    "easybill-xero"
  ],
  "editable": true,
  "schemaVersion": 39,
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "refresh": "5m",
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus",
        "current": {}
      },
      {
        "name": "lookback",
        "label": "Lookback",
        "type": "textbox",
        "query": "25h",
        "current": {
          "text": "25h",
          "value": "25h"
        },
        "description": "Longer than the sync schedule; a run older than this counts as missing."
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Last successful sync",
      "description": "Time since a sync command last finished without a run-level error. Failed invoices don't count as a failed run; they are listed below. Adjust the thresholds to the schedule.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 5,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 7200
              },
              {
                "color": "red",
                "value": 93600
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "type": "range",
              "options": {
                "from": 100000000000.0,
                "to": null,
                "result": {
                  "text": "none in lookback",
                  "color": "red"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto",
        "orientation": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "time() - max(last_over_time(easybill_xero_last_success_timestamp_seconds[$lookback])) or on() vector(1e12)",
          "instant": true,
          "range": false,
          "format": "time_series"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Last run",
      "description": "Whether the most recent sync run finished without a run-level error (authentication, easybill/Xero unreachable, state file).",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 5,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "FAILED",
                  "color": "red"
                },
                "1": {
                  "text": "OK",
                  "color": "green"
                }
              }
            }
          ],
          "noValue": "no run in lookback"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto",
        "orientation": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "min(last_over_time(easybill_xero_last_run_success[$lookback]) and on(command) (last_over_time(easybill_xero_last_run_timestamp_seconds[$lookback]) == on() group_left() max(last_over_time(easybill_xero_last_run_timestamp_seconds[$lookback]))))",
          "instant": true,
          "range": false,
          "format": "time_series"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Invoices needing action",
      "description": "Invoices and credit notes with a problem status in the latest run.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 9,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto",
        "orientation": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "count((last_over_time(easybill_xero_document_issue_reported_at_timestamp_seconds[$lookback]) == on() group_left() max(last_over_time(easybill_xero_last_run_timestamp_seconds[$lookback])))) or on() vector(0)",
          "instant": true,
          "range": false,
          "format": "time_series"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Amount affected",
      "description": "Gross total of the invoices needing action (credit notes negative), per currency.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 13,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "noValue": "0",
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto",
        "orientation": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "sum by (currency) (last_over_time(easybill_xero_document_issue_amount[$lookback]) and on(document_id, status) (last_over_time(easybill_xero_document_issue_reported_at_timestamp_seconds[$lookback]) == on() group_left() max(last_over_time(easybill_xero_last_run_timestamp_seconds[$lookback]))))",
          "instant": true,
          "range": false,
          "format": "time_series",
          "legendFormat": "{{currency}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Oldest open issue",
      "description": "How long the oldest invoice needing action has been in its current problem status.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 17,
        "y": 0,
        "w": 3,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 86400
              },
              {
                "color": "red",
                "value": 259200
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "noValue": "none"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto",
        "orientation": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "time() - min(last_over_time(easybill_xero_document_issue_since_timestamp_seconds[$lookback]) and on(document_id, status) (last_over_time(easybill_xero_document_issue_reported_at_timestamp_seconds[$lookback]) == on() group_left() max(last_over_time(easybill_xero_last_run_timestamp_seconds[$lookback]))))",
          "instant": true,
          "range": false,
          "format": "time_series"
        }
      ]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Customers needing action",
      "description": "Customers blocked or failed in the latest run. Their invoices fail as failed_customer.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 20,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto",
        "orientation": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "count((last_over_time(easybill_xero_customer_issue_reported_at_timestamp_seconds[$lookback]) == on() group_left() max(last_over_time(easybill_xero_last_run_timestamp_seconds[$lookback])))) or on() vector(0)",
          "instant": true,
          "range": false,
          "format": "time_series"
        }
      ]
    },
    {
      "id": 7,
      "type": "table",
      "title": "Invoices needing action",
      "description": "Click a number to open the invoice in easybill. The error message is in the logs, by document_id.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 16,
        "h": 10
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "In this status for"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Amount"
            },
            "properties": [
              {
                "id": "unit",
                "value": "none"
              },
              {
                "id": "decimals",
                "value": 2
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Number"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Open in easybill",
                    "url": "https://app.easybill.de/documents/edit/${__data.fields[\"easybill id\"]}",
                    "targetBlank": true
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "In this status for",
            "desc": true
          }
        ]
      },
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "names": [
                "number",
                "status",
                "Value #A",
                "Value #B",
                "currency",
                "customer_id",
                "document_id"
              ]
            }
          }
        },
        {
          "id": "organize",
          "options": {
            "indexByName": {
              "number": 0,
              "status": 1,
              "Value #A": 2,
              "Value #B": 3,
              "currency": 4,
              "customer_id": 5,
              "document_id": 6
            },
            "renameByName": {
              "number": "Number",
              "status": "Status",
              "Value #A": "In this status for",
              "Value #B": "Amount",
              "currency": "Currency",
              "customer_id": "Customer",
              "document_id": "easybill id"
            }
          }
        }
      ],
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "time() - (last_over_time(easybill_xero_document_issue_since_timestamp_seconds[$lookback]) and on(document_id, status) (last_over_time(easybill_xero_document_issue_reported_at_timestamp_seconds[$lookback]) == on() group_left() max(last_over_time(easybill_xero_last_run_timestamp_seconds[$lookback]))))",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "B",
          "expr": "last_over_time(easybill_xero_document_issue_amount[$lookback]) and on(document_id, status) (last_over_time(easybill_xero_document_issue_reported_at_timestamp_seconds[$lookback]) == on() group_left() max(last_over_time(easybill_xero_last_run_timestamp_seconds[$lookback])))",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ]
    },
    {
      "id": 8,
      "type": "table",
      "title": "Customers needing action",
      "description": "blocked: syncing would duplicate or mislink a Xero contact (see the logs for why). failed: the upsert failed.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 16,
        "y": 4,
        "w": 8,
        "h": 10
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "In this status for"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "In this status for",
            "desc": true
          }
        ]
      },
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "names": [
                "customer_id",
                "status",
                "Value"
              ]
            }
          }
        },
        {
          "id": "organize",
          "options": {
            "indexByName": {
              "customer_id": 0,
              "status": 1,
              "Value": 2
            },
            "renameByName": {
              "customer_id": "Customer",
              "status": "Status",
              "Value": "In this status for"
            }
          }
        }
      ],
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "time() - (last_over_time(easybill_xero_customer_issue_since_timestamp_seconds[$lookback]) and on(customer_id, status) (last_over_time(easybill_xero_customer_issue_reported_at_timestamp_seconds[$lookback]) == on() group_left() max(last_over_time(easybill_xero_last_run_timestamp_seconds[$lookback]))))",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ]
    },
    {
      "id": 9,
      "type": "bargauge",
      "title": "Invoices by status",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "basic",
        "showUnfilled": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "sum by (status) (last_over_time(easybill_xero_documents[$lookback]))",
          "instant": true,
          "range": false,
          "format": "time_series",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "id": 10,
      "type": "bargauge",
      "title": "Customers by status",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 8,
        "y": 14,
        "w": 6,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "basic",
        "showUnfilled": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "sum by (status) (last_over_time(easybill_xero_customers[$lookback]))",
          "instant": true,
          "range": false,
          "format": "time_series",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "id": 11,
      "type": "text",
      "title": "What the statuses mean",
      "gridPos": {
        "x": 14,
        "y": 14,
        "w": 10,
        "h": 8
      },
      "options": {
        "mode": "markdown",
        "content": "| Status | Meaning | Who acts |\n|---|---|---|\n| `failed_config` | Tax key or booking account not mapped | config maintainer |\n| `failed_customer` | Customer missing, blocked or failed | fix the customer in easybill |\n| `failed_document` | Invoice incomplete (number, date, lines) | fix the invoice in easybill |\n| `total_mismatch` | Xero total differs from easybill | accountant |\n| `failed_xero` | API error, usually transient | nobody, unless it persists |\n| `pdf_missing` | Synced, PDF attachment failed | nobody, retried each run |\n| `removed_in_xero` | Deleted/voided in Xero, valid in easybill | skip it or re-create |\n| `synced` / `approved_in_xero` / `skipped` | Fine | nobody |"
      }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Invoices by status over time",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 22,
        "w": 24,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "stepAfter",
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "sum by (status) (last_over_time(easybill_xero_documents[$lookback]))",
          "instant": false,
          "range": true,
          "format": "time_series",
          "legendFormat": "{{status}}"
        }
      ]
    }
  ]
}
